<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="penguinpeek"
        Arguments=""
        InstallLocation="C:\Program Files\PenguinPeek\PenguinPeek">
    </Installer>
    <PackageInformation
        PackageName="PenguinPeek"
        PackageDisplayName="PenguinPeek"
        PublisherName="CN=PenguinPeek"
        PublisherDisplayName="PenguinPeek"
        Version="1.0.0.0"
        PackageDescription="Lightweight WSL2 tray monitor">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="com.penguinpeek.app"
                Description="Lightweight WSL2 tray monitor"
                DisplayName="PenguinPeek"
                ExecutableName="penguinpeek"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>PenguinPeek</DisplayName>
            <PublisherDisplayName>PenguinPeek</PublisherDisplayName>
            <Description>Lightweight WSL2 tray monitor</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="penguinpeek.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
